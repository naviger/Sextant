      }
    ],
    "client": {
      "sextant-app": [
        {
          "name": "user",
          "description": "User role"
        },
        {
          "name": "admin",
          "description": "Administrator role"
        }
      ],
      "sextant-api": [
        {
          "name": "user",
          "description": "User role"
        },
        {
          "name": "admin",
          "description": "Administrator role"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "sextant-app",
      "name": "Sextant Frontend Application",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "address",
        "phone"
      ]
    },
    {
      "clientId": "sextant-api",
      "name": "Sextant API",
      "enabled": true,
      "publicClient": false,
      "redirectUris": [
