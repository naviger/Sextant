# Environment Configuration for Sextant Application

# ENVIRONMENT SETUP
ENVIRONMENT=development
DEBUG=true

# KEYCLOAK CONFIGURATION
KEYCLOAK_ADMIN_PASSWORD=changeme123
KEYCLOAK_DB_PASSWORD=keycloak123
KEYCLOAK_HOST=localhost
KEYCLOAK_REALM=sextant
KEYCLOAK_CLIENT_ID=sextant-app
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# API BACKEND CONFIGURATION
API_ENVIRONMENT=development
API_DEBUG=true
API_URL=http://localhost:8000
API_WORKERS=4

# ARANGODB CONFIGURATION
ARANGODB_ROOT_PASSWORD=arangodb123
ARANGODB_USER=root
DATABASE_URL=http://arangodb:8529
DATABASE_NAME=sextant

# FRONTEND CONFIGURATION
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:8000
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_REALM=sextant
REACT_APP_KEYCLOAK_CLIENT_ID=sextant-app

# SECURITY
JWT_ALGORITHM=RS256
JWT_EXPIRATION_HOURS=24

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# LOGGING
LOG_LEVEL=INFO
LOG_FORMAT=json

# EMAIL (MAILHOG - Development)
SMTP_SERVER=mailhog
SMTP_PORT=1025
SMTP_USER=test@example.com
SMTP_PASSWORD=test
SMTP_FROM=noreply@sextant.local
SMTP_USE_TLS=false

# RATE LIMITING
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# DATABASE BACKUPS
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *

# OLLAMA LLM (Local AI/ML Models)
# Ollama provides local LLM access without external API calls
# Available models: llama2, mistral, neural-chat, and others
# See: https://ollama.ai/library
OLLAMA_HOST=http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=true
OLLAMA_DEFAULT_MODEL=llama2
OLLAMA_REQUEST_TIMEOUT=300
